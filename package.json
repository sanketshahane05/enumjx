{
  "name": "enumjx",
  "version": "0.1.1",
  "author": {
    "name": "Sanket Shahane",
    "url": "https://sanketshahane.in/"
  },
  "contributors": [
    {
      "name": "Sanket Shahane",
      "url": "https://github.com/sanketshahane05/"
    }
  ],
  "description": "JavaScript enums with stable identity, parsing, metadata, flags, and React select components",
  "keywords": [
    "enum",
    "enums",
    "javascript",
    "typescript",
    "react",
    "flags",
    "bitwise"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanketshahane05/enumjx.git"
  },
  "homepage": "https://sanketshahane05.github.io/enumjx/",
  "bugs": "https://github.com/sanketshahane05/enumjx/issues",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "enums.js",
    "enums.min.js",
    "enums.d.ts",
    "react.js",
    "react.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "npm run build:min && node --test enums.test.mjs react.test.mjs",
    "build:min": "terser enums.js --module --compress --mangle --comments some --output enums.min.js",
    "typecheck": "tsc -p tsconfig.types.json",
    "check": "npm run test && npm run typecheck && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.0.0"
  }
}
